# Настройки сервера. Всё про магазин заказчик вводит в панели.

# Пароль к базе (нужен docker compose).
POSTGRES_PASSWORD=

# Для запуска без docker: адрес базы напрямую.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/repricer

# Ключ доступа к API. Придумайте длинную строку, тот же ключ впишите панели.
REPRICER_API_KEY=

# Вход в панель.
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=

# Публичная ссылка на фид — её владелец вставит в кабинет Kaspi.
FEED_PUBLIC_URL=http://localhost:8000/feed/kaspi.xml

# Куда воркер кладёт копию прайс-листа (API отдаёт фид и без этого).
FEED_DIR=feeds

# Порты наружу.
API_PORT=8000
WEB_PORT=3000
