# Настройки сервера. Всё про магазин заказчик вводит в панели.

# Пароль к базе: используйте длинную строку из букв и цифр без символов URL.
POSTGRES_PASSWORD=

# Для запуска без docker: адрес базы напрямую.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/repricer

# Ключ доступа к API. Придумайте длинную строку, тот же ключ впишите панели.
REPRICER_API_KEY=

# Вход в панель.
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=

# Домен без https://, например my-shop.duckdns.org.
SITE_DOMAIN=

# Единственный токен бота. Храните только в серверном .env, не в Git.
TELEGRAM_BOT_TOKEN=

# Куда воркер кладёт копию прайс-листа (API отдаёт фид и без этого).
FEED_DIR=feeds

# Публичная ссылка автоматически станет https://${SITE_DOMAIN}/feed/kaspi.xml.
