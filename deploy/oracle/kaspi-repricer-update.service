[Unit]
Description=Deploy new Kaspi Repricer main commits
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kaspi-dumping
ExecStart=/bin/bash /home/ubuntu/kaspi-dumping/deploy/oracle/update.sh
TimeoutStartSec=3600
